# Приклад конфігурації. Скопіювати у .env і заповнити власними значеннями.
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change-me
# Необов'язково: токен хмарного сервісу Hugging Face.
# Якщо не заданий, застосунок використовує локальну резервну модель.
HF_API_TOKEN=
HF_MODEL=distilbert-base-uncased-finetuned-sst-2-english
